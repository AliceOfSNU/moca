[Unit]
Description=에이전트 커피챗 안내 페이지 (정적 파일, 인터넷에 공개)
After=network-online.target

[Service]
Type=simple
# 루트로 돌리지 않는다. 80번을 열 수 있는 권한만 따로 준다.
User=www-data
Group=www-data
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
WorkingDirectory=/opt/moca/site
ExecStart=/usr/bin/python3 -m http.server 80 --bind 0.0.0.0 --directory /opt/moca/site
Restart=always
RestartSec=10

# 이 프로세스가 닿을 수 있는 곳을 사이트 디렉터리로 좁힌다. 같은 장비에 멤버들의 1:1 기록과
# 인증 없는 대시보드가 있으므로, 공개된 프로세스는 그쪽을 아예 볼 수 없어야 한다.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
ReadOnlyPaths=/opt/moca/site
InaccessiblePaths=/opt/moca/moca /opt/moca/dashboard /opt/moca/.venv

[Install]
WantedBy=multi-user.target
